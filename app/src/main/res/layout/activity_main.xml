<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Centrum Sterowania Światłem"
        android:textColor="#FFFFFF"
        android:background="#3f51b5"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
         />
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        >

        <ImageView
            android:id="@+id/img_salon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="#FFFFFF"
            android:src="@android:drawable/btn_star_big_on"
            />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btn_salon"
            android:layout_margin="8dp"
            android:text="Salon: Biały"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:onClick="zmianaKoloru"
            />
        <ImageView
            android:id="@+id/img_kuchnia"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="#FFFFFF"
            android:src="@android:drawable/btn_star_big_on"
            />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btn_kuchnia"
            android:layout_margin="8dp"
            android:text="Kuchnia: Biały"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:onClick="zmianaKoloru"
            />
        <ImageView
            android:id="@+id/img_sypialnia"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="#FFFFFF"
            android:src="@android:drawable/btn_star_big_on"
            />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btn_sypialnia"
            android:layout_margin="8dp"
            android:text="Sypialnia: Biały"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:onClick="zmianaKoloru"
            />

    </GridLayout>

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/radioGroup"
        android:layout_margin="8dp"
        android:orientation="vertical"
        android:checkedButton="@id/rb_dzienny">
        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/rb_dzienny"
            android:text="Tryb Dzienny"
            />
        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/rb_wieczorny"
            android:text="Tryb Wieczorny"
            />
        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/rb_nocny"
            android:text="Tryb Nocny"
            />
    </RadioGroup>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/btn_zapisz"
        android:layout_margin="8dp"
        android:text="Zapisz Scenę"
        android:onClick="zapiszScene"
        />
    <ListView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/listView"
        android:layout_weight="1"
        android:layout_margin="8dp"
        />

</LinearLayout>